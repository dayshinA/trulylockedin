# Firebase client (public; used for Auth sign-in only)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only; service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_REFERENCE_PRESET=          # booking reference photos (authenticated delivery)

# Email (Resend)
RESEND_API_KEY=                  # server-only
EMAIL_FROM=                      # "Truly Locked In <onboarding@resend.dev>" until a domain is verified, then e.g. "Truly Locked In <bookings@your-domain>"
OWNER_NOTIFY_EMAIL=              # where new booking/order alerts go
CUSTOMER_EMAILS_ENABLED=         # "true" only once a domain is verified (resend.dev can only email the account owner)

# Stripe (deposits; server-only). Sandbox values in development, live at go-live.
STRIPE_SECRET_KEY=               # sk_test_… / rk_live_… (Developers → API keys)
STRIPE_WEBHOOK_SECRET=           # whsec_…: printed by `stripe listen` locally; the live endpoint's signing secret in production

# App
NEXT_PUBLIC_SITE_URL=
ADMIN_COOKIE_SECURE=             # set to false only when serving over plain http (no HTTPS); remove once HTTPS exists

# Sentry (error monitoring)
NEXT_PUBLIC_SENTRY_DSN=          # browser; the project DSN (public)
SENTRY_DSN=                      # server/edge; same DSN
SENTRY_AUTH_TOKEN=               # build-time only: uploads source maps (Sentry → Settings → Auth Tokens, org token)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=  # optional; defaults to NODE_ENV (e.g. "production", "staging")
